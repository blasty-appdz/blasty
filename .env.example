# ─────────────────────────────────────────────
# Blasty — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────

# Twilio (pour le serveur OTP dans server/)
# Obtenir sur : https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# React App (optionnel, si vous utilisez des variables d'env côté frontend)
# REACT_APP_SERVER_URL=https://blasty-production.up.railway.app
# REACT_APP_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# REACT_APP_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
